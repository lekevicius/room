# RoomBrowserWindow: Chrome's BrowserWindow for a window the Swift host owns.

source_set("browser") {
  visibility = [ "//room/*" ]
  sources = [
    "room_browser_window.h",
    "room_browser_window.mm",
    "room_browser_window_stubs.cc",
    "room_exclusive_access_context.cc",
    "room_exclusive_access_context.h",
    "room_location_bar.cc",
    "room_location_bar.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/ui",
    "//chrome/browser/ui:sad_tab",
    "//chrome/browser/ui/location_bar",
    "//chrome/browser/ui/browser_active_state_manager",
    "//chrome/browser/ui/exclusive_access",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/find_bar",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/views:bubble_anchor_util_views",
    "//chrome/browser/ui/views:find_bar_owner",
    "//chrome/browser/ui/views/frame:toolbar_button_provider",
    "//chrome/browser/ui/views/interaction:impl",
    "//components/input",
    "//components/web_modal",
    "//content/public/browser",
    "//ui/base",
    "//ui/gfx",
    "//ui/views",
  ]
  frameworks = [ "AppKit.framework" ]
}
