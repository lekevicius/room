# The public Objective-C API (the ROOM_EXPORT classes in public/). The official
# build links the framework with -exported_symbols_list
# chrome/app/framework.exports, which hides every other symbol; patch 0004
# adds this list beside it so the Swift app can link the classes. The
# component build exports them through their default visibility alone.
# Keep in step with public/*.h.
# Order: as `nm -jUng` lists them in the official framework (address order,
# which follows the link order of //room/core's objects), because
# verify_chrome_framework_order (patch 0004) checks the exports against
# framework.order followed by this list. A new class goes where nm puts it;
# the check's "actual order" output is the list to copy (3.9-2).
_OBJC_CLASS_$_RoomApplication
_OBJC_METACLASS_$_RoomApplication
_OBJC_CLASS_$_RoomAutocompleteMatch
_OBJC_METACLASS_$_RoomAutocompleteMatch
_OBJC_CLASS_$_RoomAutocompleteController
_OBJC_METACLASS_$_RoomAutocompleteController
_OBJC_CLASS_$_RoomBrowser
