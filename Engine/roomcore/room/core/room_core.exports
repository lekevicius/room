# The public Objective-C API (the ROOM_EXPORT classes in public/). The official
# build links the framework with -exported_symbols_list
# chrome/app/framework.exports, which hides every other symbol; patch 0004
# adds this list beside it so the Swift app can link the classes. The
# component build exports them through their default visibility alone.
# Keep in step with public/*.h.
