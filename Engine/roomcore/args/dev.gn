# Dev (component) build of the fork: fast incremental links, no symbols.
# Copied to out/dev/args.gn in ~/chromium/src by scripts/roomcore-apply.sh.
is_component_build = true
is_debug = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_widevine = true
# safe_browsing_mode = 0 is not set: on M154 desktop Chrome targets (feedback,
# report-unsafe-site, suspicious-site warnings) depend on Safe Browsing code and
# `gn gen` fails with unresolved dependencies. Safe Browsing stays compiled in
# (mode 1) and inert: no API key is configured.
enable_updater = false
use_siso = true

# Room branding (Engine/roomcore/room/branding): product "Room", bundle ids
# app.room.desktop*, icons from the "room" theme component (placeholders
# that point at Chromium's icons until Room has its own).
branding_file_path = "//room/branding/BRANDING"
branding_path_component = "room"

# Google-specific pieces Room does not want.
enable_hangout_services_extension = false

# Spike hooks and diagnostics (//room/build/config.gni): on in dev builds only.
room_enable_spikes = true
