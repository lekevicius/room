Room: chrome_dll depends on //room/core, so the public Objective-C API is
inside the framework.

chrome_dll_symbol_exports (added 2026-10-04, Phase 3.1b-2): official
non-component builds link the framework with -exported_symbols_list
chrome/app/framework.exports (three symbols), which hid the ROOM_EXPORT
classes. Reproducible release-build failure (args/release.gn): the Swift app
failed to link against out/release's RoomCore.framework with undefined
_OBJC_CLASS_$_RoomApplication, RoomBrowser, RoomCrApplication,
RoomWebContents and _OBJC_METACLASS_$_RoomCrApplication. The second list,
//room/core/room_core.exports, names the five classes.

chrome/tools/build/mac/verify_order.py then checks the framework's exports
against chrome/app/framework.order and failed on the five classes
("unexpected export: '_OBJC_CLASS_$_RoomApplication' is not in list");
verify_chrome_framework_order reads a generated list, framework.order
followed by room_core.exports (the order nm reports them in).

diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index 80052a531011d..1e97cca143fdb 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -1272,6 +1272,13 @@ if (is_win) {
       "-Wl,-exported_symbols_list",
       "-Wl," + rebase_path("app/framework.exports", root_build_dir),
     ]
+
+    # Room: keep the public Objective-C API global in the framework.
+    inputs += [ "//room/core/room_core.exports" ]
+    ldflags += [
+      "-Wl,-exported_symbols_list",
+      "-Wl," + rebase_path("//room/core/room_core.exports", root_build_dir),
+    ]
   }
 
   # Control the order of exported symbols in the framework library.
@@ -1336,6 +1343,9 @@ if (is_win) {
       "//third_party/cld_3/src/src:cld_3",
     ]
 
+    # Room: the public Objective-C API (RoomCore.h) lives in the framework.
+    deps += [ "//room/core" ]
+
     if (is_chromeos) {
       deps += [ "//chrome/browser/ash/schedqos" ]
     }
@@ -1444,6 +1454,11 @@ if (is_win) {
   # TOOD(crbug.com/40740432#comment9) - thakis@ look into why profile and
   # coverage instrumentation adds these symbols in different orders
   if (!is_component_build && chrome_pgo_phase != 1 && !using_sanitizer) {
+    # Room: the public Objective-C API is exported too (chrome_dll_symbol_exports).
+    _room_framework_order = "$target_gen_dir/room_framework.order"
+    write_file(_room_framework_order,
+               read_file("app/framework.order", "list lines") +
+                   read_file("//room/core/room_core.exports", "list lines"))
     action("verify_chrome_framework_order") {
       script = "//chrome/tools/build/mac/verify_order.py"
       stamp_file = "$target_out_dir/run_$target_name.stamp"
@@ -1451,7 +1466,7 @@ if (is_win) {
       args = [
         "--stamp=" + rebase_path(stamp_file, root_out_dir),
         "--binary=" + rebase_path(_framework_binary_path, root_out_dir),
-        "--symbol-file=" + rebase_path("app/framework.order", root_build_dir),
+        "--symbol-file=" + rebase_path(_room_framework_order, root_build_dir),
       ]
       if (host_os == "mac") {
         args += [ "--nm-path=$mac_bin_path/nm" ]
