@@ -193,6 +193,13 @@
 #include "chrome/browser/ui/search/new_tab_page_navigation_throttle.h"
 #endif
 
+namespace room {
+// Room: set by //room/core at startup. Adds //room's navigation throttle to
+// navigations of Room pages (the host's navigation policy, Peek).
+void (*g_navigation_throttles_hook)(content::NavigationThrottleRegistry&) =
+    nullptr;
+}  // namespace room
+
 namespace {
 
 // Wrapper for SSLErrorHandler::HandleSSLError() that supplies //chrome-level
@@ -634,6 +641,10 @@ void CreateAndAddChromeThrottlesForNavigation(
   glic::GlicGuestNavigationThrottle::MaybeCreateAndAdd(registry);
 
   pwc::PwcNavigationThrottle::MaybeCreateAndAdd(registry);
+
+  if (room::g_navigation_throttles_hook) {
+    room::g_navigation_throttles_hook(registry);
+  }
 }
 
