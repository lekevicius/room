 #include "ui/views/widget/widget.h"
 #include "ui/views/window/dialog_client_view.h"
 
+namespace room {
+// Room: set by //room/core at startup. Takes the external protocol request of
+// a page in a Room window (the host's confirmation) and returns true; false
+// otherwise (Chrome's dialog).
+bool (*g_run_external_protocol_dialog_hook)(
+    const GURL&,
+    content::WebContents*,
+    bool has_user_gesture,
+    const std::optional<url::Origin>&,
+    content::WeakDocumentPtr&,
+    const std::u16string& program_name) = nullptr;
+}  // namespace room
+
 using content::WebContents;
 
 namespace {
@@ -107,6 +120,13 @@ void ExternalProtocolHandler::RunExternalProtocolDialog(
     return;
   }
 
+  if (room::g_run_external_protocol_dialog_hook &&
+      room::g_run_external_protocol_dialog_hook(
+          url, web_contents, ignored_has_user_gesture, initiating_origin,
+          initiator_document, program_name)) {
+    return;
+  }
+
   // Windowing system takes ownership.
   new ExternalProtocolDialog(web_contents, url, program_name, initiating_origin,
                              std::move(initiator_document));
