# Per-machine settings for the Chromium/RoomCore scripts. Copy to local.env
# (gitignored) and edit; read by scripts/lib/chromium-env.sh. Environment
# variables of the same name take precedence.

# gclient root; the checkout is $CHROMIUM_ROOT/src. Default: ~/chromium
#CHROMIUM_ROOT=/Volumes/Chromium/chromium

# Disk image holding CHROMIUM_ROOT's volume, attached by the scripts when the
# volume is not mounted. Needed when the only big drive is exFAT/HFS: Chromium
# needs APFS (symlinks, permissions, clones). Create one with
#   hdiutil create -type SPARSEBUNDLE -fs APFS -size 350g -volname Chromium /Volumes/<drive>/Chromium.sparsebundle
#CHROMIUM_IMAGE=/Volumes/JL4/Chromium.sparsebundle

# Default: ~/depot_tools
#DEPOT_TOOLS=$HOME/depot_tools
