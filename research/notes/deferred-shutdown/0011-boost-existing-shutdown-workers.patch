 void WorkerThread::MaybeBoostPriorityForShutdown() {
+#if BUILDFLAG(IS_APPLE)
+  CheckedAutoLock auto_lock(thread_lock_);
+  // Check exit before touching the tracker, which may no longer be usable.
+  if (thread_main_exited_ || thread_handle_.is_null() ||
+      shutdown_priority_override_ || thread_type_hint_ >= ThreadType::kDefault ||
+      !task_tracker_->HasShutdownStarted()) {
+    return;
+  }
+  shutdown_priority_override_ =
+      SetThreadTypeOverride(thread_handle_, ThreadType::kDefault);
+#else
   if (priority_boost_.has_value() && !priority_boost_->IsActive() &&
       task_tracker_->HasShutdownStarted() &&
       thread_type_hint_ < ThreadType::kDefault) {
     priority_boost_->BoostPriority(ThreadType::kDefault);
   }
+#endif
 }
 
